{
  "name": "gridterm",
  "version": "0.1.0",
  "description": "Multi-session grid terminal for macOS and Linux",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:e2e": "node e2e/smoke.cjs",
    "test:e2e:context": "node e2e/context.cjs bash && node e2e/context.cjs zsh",
    "test:e2e:config": "node e2e/config.cjs",
    "test:e2e:all": "node e2e/run-all.cjs",
    "test:e2e:restore": "node e2e/restore.cjs",
    "test:e2e:security": "node e2e/security.cjs bash && node e2e/security.cjs zsh",
    "postinstall": "node scripts/fix-node-pty.cjs",
    "test:shell": "node e2e/shell.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-vite": "^6.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "^1.9.1"
  },
  "engines": {
    "node": ">=20"
  }
}
